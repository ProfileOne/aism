{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aism-vc3k.onrender.com/api/:path*"
    },
    {
      "source": "/aism/(.*)",
      "destination": "/aism/$1"
    },
    {
      "source": "/aism",
      "destination": "/aism/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/aism/index.html"
    }
  ]
}